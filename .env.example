# Names only. Real values live in Vercel → Project → Settings → Environment Variables.
# None of these use the VITE_ prefix, so Vite never bundles them into client code.

# Resend (https://resend.com) API key, used only by /api/contact
RESEND_API_KEY=

# Where contact messages are delivered
CONTACT_TO_EMAIL=

# Verified sender, e.g. "Portfolio <onboarding@resend.dev>" until a domain is verified
CONTACT_FROM_EMAIL=

# Upstash Redis REST credentials for rate limiting.
# The Vercel Marketplace integration may name them KV_REST_API_URL / KV_REST_API_TOKEN instead;
# both spellings are accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Random secret used to hash IPs before they reach Redis (e.g. `openssl rand -hex 32`)
RATE_LIMIT_SALT=

# Optional: extra comma-separated origins allowed to POST the form (e.g. a custom domain).
# Vercel's own deployment URLs are allowed automatically.
ALLOWED_ORIGINS=
